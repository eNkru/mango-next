{{define "views/react-shell"}}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Mango - {{.PageName}}</title>
  <script>
    // FOUC: apply flat/comic + dark markers on <html> before paint.
    (function () {
      var style = localStorage.getItem('ui-style');
      if (style !== 'flat' && style !== 'comic') style = 'comic';
      var theme = localStorage.getItem('theme') || 'system';
      var dark = theme === 'dark' || (theme === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (style === 'flat') {
        document.documentElement.classList.add('flat-theme');
        if (dark) document.documentElement.classList.add('flat-theme-dark');
      } else {
        document.documentElement.classList.add('comic-theme');
        if (dark) document.documentElement.classList.add('comic-theme-dark');
      }
      if (dark) document.documentElement.style.background = style === 'flat' ? '#141414' : '';
    })();
    // FOUC: set <html lang> before paint from the stored language. Mirrors
    // applyDocumentLanguage in frontend/src/lib/i18n.tsx — keep the mapping in
    // sync (en→en, zh-tw→zh-Hant, else zh-Hans) so first paint matches JS.
    (function () {
      var lang = localStorage.getItem('mango-language');
      var map = { 'en': 'en', 'zh-tw': 'zh-Hant' };
      document.documentElement.lang = Object.prototype.hasOwnProperty.call(map, lang) ? map[lang] : 'zh-Hans';
    })();
  </script>
  <link rel="icon" href="{{.BaseURL}}favicon.ico">
  {{if .MainCSS}}<link rel="stylesheet" href="{{.BaseURL}}react/{{.MainCSS}}">{{end}}
</head>
<body>
  <script type="application/json" id="mango-boot">{{.BootJSON}}</script>
  <div id="root"></div>
  {{if .MainJS}}<script type="module" src="{{.BaseURL}}react/{{.MainJS}}"></script>{{end}}
</body>
</html>
{{end}}
